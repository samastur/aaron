   "showsCopyNote": true,
   "otherCopiesShowNote": true
  },
  "snapshot": "copy-note"
 },
 {
  "caretAtEnd": true,
  "type": "\nCopy sync marker.",
  "save": true,
  "wait": 3.0,
  "expect": {
   "copiesOf": 2,
   "windowCount": 2,
   "allCopiesContain": "Copy sync marker.",
   "copiesEdited": false,
