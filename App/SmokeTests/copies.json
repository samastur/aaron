  },
  "dismissCopyNote": true
 },
 {
  "closeOtherCopies": true,
  "wait": 1.0,
  "expect": {
   "copiesOf": 1,
   "windowCount": 1,
   "showsCopyNote": false
  }
 },
 {
  "type": " After closing.",
  "save": true,
  "wait": 1.0,
  "expect": {
   "textContains": "Copy sync marker. After closing."
  }
 },
 {
  "openAgain": true,
  "wait": 2.0,
  "expect": {
   "copiesOf": 2,
   "windowCount": 2,
   "allCopiesContain": "After closing.",
   "showsCopyNote": true
  }
 },
 {
  "type": " Undo me.",
  "save": true,
  "wait": 3.0,
  "expect": {
   "copiesOf": 2,
   "windowCount": 2,
   "allCopiesContain": "Undo me.",
   "copiesEdited": false
  }
 },
 {
  "undoInOtherCopies": true,
  "wait": 0.5,
  "expect": {
   "copiesOf": 2,
   "windowCount": 2,
